# travel-mcp-server configuration. Copy to .env (never commit .env) or set these
# in your MCP client's "env" block. Only FLIGHTAPI_KEY is needed to get started.

# --- Data providers -----------------------------------------------------------

# Your FlightAPI.io key (https://www.flightapi.io/, free tier: 100 requests / 30 days).
# Without it, search_airports and convert_currency still work.
FLIGHTAPI_KEY=

# Currency used for flight prices when the user does not ask for one. ISO 4217.
DEFAULT_CURRENCY=USD

# --- Credit protection --------------------------------------------------------

# Maximum FlightAPI requests per rolling minute / 24 hours from this server (0 = unlimited).
# Cache hits never count. When exceeded, tools return a friendly error instead of calling the API.
FLIGHTAPI_MAX_PER_MINUTE=10
FLIGHTAPI_MAX_PER_DAY=100

# Cache lifetimes.
CACHE_TTL_PRICES_MIN=30
CACHE_TTL_STATUS_MIN=2
CACHE_TTL_FX_HOURS=12

# Persist the cache to disk so restarts don't re-spend credits.
# ENABLE_FILE_CACHE=true uses ~/.cache/mcp-server-travel/cache.json; CACHE_FILE sets a custom path.
ENABLE_FILE_CACHE=false
# CACHE_FILE=/path/to/cache.json

# Per-attempt upstream timeout in milliseconds (one retry on network errors, never on HTTP errors).
REQUEST_TIMEOUT_MS=10000

# --- Transport ----------------------------------------------------------------

# stdio (default, for local desktop apps) or http (Streamable HTTP, for remote clients).
# The --http / --stdio CLI flags override this.
MCP_TRANSPORT=stdio

# HTTP mode only. Binds to localhost by default; put a TLS proxy in front for remote use.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000

# Required in HTTP mode (min 16 chars). Clients send "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
MCP_HTTP_TOKEN=

# Optional: also accept the token as a secret URL path (POST /mcp/<token>) for clients
# that cannot send custom headers, e.g. ChatGPT connectors in "No authentication" mode.
# Only use this over HTTPS; the URL then acts as the password.
MCP_HTTP_ALLOW_PATH_TOKEN=false

# Optional: comma-separated Host header allowlist (DNS rebinding protection) when binding to a
# non-loopback address, e.g. travel-mcp.example.com
# MCP_HTTP_ALLOWED_HOSTS=

# --- Logging ------------------------------------------------------------------

# debug | info | warn | error | silent. Logs go to stderr; secrets are always redacted.
LOG_LEVEL=info
